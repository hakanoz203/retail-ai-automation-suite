    {
      "parameters": {
        "jsCode": "// Build a public URL fal.ai can fetch\nconst fileId = $('Drive Trigger - New Product Image').item.json.id;\nconst fileName = $('Drive Trigger - New Product Image').item.json.name;\n\n// Direct download URL — fal.ai can fetch from this\nconst publicUrl = `https://drive.google.com/uc?export=download&id=${fileId}`;\n\nreturn [{\n  json: {\n    file_id: fileId,\n    file_name: fileName,\n    public_url: publicUrl\n  },\n  binary: $input.first().binary\n}];"
      },
      "id": "47a28e02-0153-459a-8ac8-bebfa6d950ba",
      "name": "Build Public URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// item bir array veya array benzeri obje — ilk elemanı al\nconst msg = Array.isArray(item) ? item[0] : item['0'] || item;\n\n// content array'inden text bloğunu bul\nlet raw = '';\nif (Array.isArray(msg.content)) {\n  const textBlock = msg.content.find(b => typeof b?.text === 'string');\n  if (textBlock) raw = textBlock.text;\n}\n\nif (!raw) {\n  throw new Error('Text bulunamadi. msg: ' + JSON.stringify(msg).substring(0, 300));\n}\n\n// Temizle\nraw = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n\n// İlk { ile son } arasını al\nconst f = raw.indexOf('{');\nconst l = raw.lastIndexOf('}');\nif (f !== -1 && l !== -1) raw = raw.substring(f, l + 1);\n\nlet meta;\ntry {\n  meta = JSON.parse(raw);\n} catch (e) {\n  throw new Error('JSON parse hatasi. Metin: ' + raw);\n}\n\nconst buildUrl = $('Build Public URL').item.json;\n\nreturn [{\n  json: {\n    ...buildUrl,\n    ...meta\n  }\n}];"
      },
