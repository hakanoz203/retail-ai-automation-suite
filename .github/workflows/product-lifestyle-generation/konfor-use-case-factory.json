    {
      "parameters": {
        "jsCode": "// Pick one random scenario from the fetched list\nconst scenarios = $input.all();\nif (scenarios.length === 0) {\n  throw new Error('No scenarios found for category: ' + $('Parse Metadata').item.json.kategori);\n}\n\nconst picked = scenarios[Math.floor(Math.random() * scenarios.length)];\nconst props = picked.json.property_kategori !== undefined ? picked.json : picked.json.properties;\n\n// Notion node returns flattened properties — adjust field names to your DB columns\nconst senaryoId = picked.json.senaryo_id || picked.json.property_senaryo_id || '';\nconst trAciklama = picked.json.tr_aciklama || picked.json.property_tr_aciklama || '';\nconst enPromptFragment = picked.json.en_prompt_fragment || picked.json.property_en_prompt_fragment || '';\n\nconst meta = $('Parse Metadata').item.json;\n\nreturn [{\n  json: {\n    ...meta,\n    senaryo_id: senaryoId,\n    senaryo_tr: trAciklama,\n    senaryo_en: enPromptFragment\n  }\n}];"
      },
      "id": "85158684-f4e1-429e-ba53-47b81d96ebb0",
      "name": "Pick Random Scenario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1808,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the final FLUX.1 Kontext prompt\nconst d = $input.first().json;\n\nconst categoryLabel = {\n  koltuk_takimi: 'living room sofa set',\n  kose_takimi: 'corner sectional sofa',\n  yemek_odasi: 'dining room set',\n  yatak_odasi: 'bedroom set'\n}[d.kategori] || 'furniture';\n\nconst prompt = `Edit this ${d.stil} ${categoryLabel} product photo: add ${d.senaryo_en} to the scene.\n\nCRITICAL preservation rules:\n- Keep the exact same furniture, fabric texture, color (${d.ana_renk}), and design\n- Maintain identical camera angle, perspective, framing, and depth of field\n- Preserve the original lighting direction (${d.isik_yonu}) and color temperature\n- Do not change the walls, floor, ceiling, or any background elements\n- Do not add or remove any furniture pieces\n- The added person must look natural with realistic shadows matching the scene\n- Photorealistic style for furniture e-commerce catalog\n- High detail, sharp focus on furniture, natural skin tones`;\n\nreturn [{\n  json: {\n    ...d,\n    final_prompt: prompt\n  }\n}];"
      },
